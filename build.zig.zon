.{
    .name = .diaguiinspect_zig,
    // A build-graph identity constant; Zig suggests this value for the
    // renamed package.
    .fingerprint = 0x5a595ce9e9e028b9,
    .version = "0.1.0",
    .minimum_zig_version = "0.17.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "USAGE.md",
    },
    .dependencies = .{
        // Pinned to the same revision that zgui itself pins, so that the
        // dependency graph deduplicates to a single zglfw build.
        .zglfw = .{
            .url = "git+https://github.com/zig-gamedev/zglfw#2450fe3c4140091287c79cb41e4a8020af73d896",
            .hash = "zglfw-0.10.0-dev-zgVDNHC7IQAbvGj5whD2Cp5TMmo5G2C9gNYaF-y-EDZ3",
        },
        .zopengl = .{
            .url = "git+https://github.com/zig-gamedev/zopengl#3ae35b0baf11fb402c5d559715585bfb381ae63b",
            .hash = "zopengl-0.6.0-dev-5-tnzwqkDgBbDbhJMhgzO_3aY8uRhMdZ5RjohIrvjevr",
        },
        // Vendored from zig-gamedev/zgui at 1260767 (see README) with a
